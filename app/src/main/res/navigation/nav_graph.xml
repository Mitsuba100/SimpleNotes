<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/noteFragment">

    <fragment
        android:id="@+id/settingsFragment"
        android:name="net.stuple.simplenotes.fragments.SettingsFragment"
        android:label="@string/Settings" >
        <action
            android:id="@+id/action_settingsFragment_to_noteFragment"
            app:destination="@id/noteFragment" />
    </fragment>
    <fragment
        android:id="@+id/noteFragment"
        android:name="net.stuple.simplenotes.fragments.NoteFragment"
        android:label="Simple Notes"
        tools:layout="@layout/note_fragment" >
        <action
            android:id="@+id/action_noteFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>
</navigation>